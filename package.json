{
  "name": "@coinbox-co-il/qr-scanner",
  "version": "1.5.0",
  "description": "Browser QR scanner with native detection and a local JavaScript decoder worker",
  "main": "qr-scanner.cjs",
  "module": "qr-scanner.min.js",
  "types": "types/qr-scanner.d.ts",
  "files": ["LICENSE", "THIRD_PARTY_NOTICES", "qr-scanner*.js", "qr-scanner*.js.map", "qr-scanner.cjs", "qr-scanner.cjs.map", "types/qr-scanner.d.ts"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/Coinbox-co-il/qr-scanner.git" },
  "bugs": { "url": "https://github.com/Coinbox-co-il/qr-scanner/issues" },
  "homepage": "https://github.com/Coinbox-co-il/qr-scanner#readme",
  "keywords": ["qr", "scanner", "browser"],
  "author": "Nimiq (https://nimiq.com)",
  "contributors": ["Coinbox (https://github.com/Coinbox-co-il)"],
  "license": "MIT",
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "qrcode-generator": "2.0.4",
    "typescript": "7.0.2",
    "jsqr-es6": "https://github.com/Coinbox-co-il/jsQR/releases/download/v1.4.2/coinbox-co-il-jsqr-1.4.2.tgz"
  }
}
